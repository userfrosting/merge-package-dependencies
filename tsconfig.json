{
    "$schema": "http://json.schemastore.org/tsconfig",
    "compilerOptions": {
        "module": "es2020",
        "moduleResolution": "node16",
        "lib": [
            "es2015"
        ],
        "allowSyntheticDefaultImports": true,
        "noEmitHelpers": true,
        "declaration": true,
        "target": "es2017",
        "outDir": "./dist/",
        "sourceMap": true,
        "strict": false,
        "forceConsistentCasingInFileNames": true,
        "types": [
            "node"
        ]
    }
}
